<?xml version="1.0" encoding="UTF-8"?>
<!--
  App subdomain sitemap. Only public entry points are listed — everything
  else is gated by auth and contains user-private data. Public document share
  links (/i/:token) are intentionally NOT enumerated here because their tokens
  are unguessable and shouldn't be discoverable; users share them directly.
-->
<urlset xmlns="http://www.sitemap.org/schemas/0.9/sitemap.xsd"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9
                            http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">

  <url>
    <loc>https://app.azayon.com/login</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>

  <url>
    <loc>https://app.azayon.com/register</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>

  <url>
    <loc>https://app.azayon.com/forgot-password</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>

</urlset>
